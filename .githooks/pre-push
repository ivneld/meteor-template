#!/usr/bin/env bash
# 푸시 전에 아키텍처 리뷰를 돌린다. 활성화: git config core.hooksPath .githooks
# 건너뛰기: SKIP_ARCH_REVIEW=1 git push
[ "${SKIP_ARCH_REVIEW:-0}" = 1 ] && exit 0
cd "$(git rev-parse --show-toplevel)"
review/arch-review.sh
code=$?
if [ "$code" = 1 ]; then
    echo >&2
    echo "아키텍처 리뷰 BLOCK. 위 findings 를 해결하거나 ADR 로 예외를 기록한 뒤 다시 푸시하세요. (건너뛰기: SKIP_ARCH_REVIEW=1)" >&2
    exit 1
fi
exit 0
